<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- To download a handwriting language for the Transcribe tool (ML Kit), once per language;
         recognition itself runs on the device. And, only on Study boards and only with the
         user's own Mistral API key, to send a linked PDF or a looped answer to Mistral. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Only to check that HyperOS's Notes app exists before pretending to be it for the
         Focus Pen hold shortcut (XiaomiStylusWindow). -->
    <queries>
        <package android:name="com.miui.notes" />
    </queries>

    <application
        android:label="Noti"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:hardwareAccelerated="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
