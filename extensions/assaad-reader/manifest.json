{
  "manifest_version": 3,
  "name": "Noti · Plataforma Assaad",
  "version": "3.1.0",
  "description": "Conecte a Plataforma Assaad ao seu canvas no Noti usando um código de pareamento.",
  "minimum_chrome_version": "127",
  "permissions": [
    "storage",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://app.plataformaassaad.com.br/*",
    "https://noti.vendua.com.br/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.plataformaassaad.com.br/*"
      ],
      "js": [
        "page-observer.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://app.plataformaassaad.com.br/*"
      ],
      "js": [
        "content.bundle.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Conectar ao Noti",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src https://noti.vendua.com.br wss://noti.vendua.com.br; object-src 'none'; base-uri 'none'; form-action 'none'"
  }
}
